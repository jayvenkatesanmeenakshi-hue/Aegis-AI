{
  "collections": {
    "sessions": {
      "description": "Study sessions for the user",
      "fields": {
        "title": { "type": "string", "description": "The title of the study session" },
        "subject": { "type": "string", "description": "The subject of the study session (Physics, Math, etc.)" },
        "createdAt": { "type": "timestamp", "description": "When the session was created" },
        "userId": { "type": "string", "description": "The ID of the user who owns this session" },
        "lastPrompt": { "type": "string", "description": "The last prompt used in this session" },
        "nodes": { "type": "array", "description": "The nodes in the graph" },
        "edges": { "type": "array", "description": "The edges in the graph" },
        "explanation": { "type": "string", "description": "The AI generated explanation" },
        "summary": { "type": "string", "description": "The AI generated summary" },
        "quiz": { "type": "array", "description": "The quiz questions" }
      },
      "indexes": [
        { "fields": { "userId": "ASC", "createdAt": "DESC" } }
      ]
    },
    "users": {
        "description": "User profile data",
        "fields": {
            "email": { "type": "string" },
            "displayName": { "type": "string" },
            "photoURL": { "type": "string" },
            "school": { "type": "string" },
            "syllabus": { "type": "string" },
            "grade": { "type": "number" },
            "subjects": { "type": "array" },
            "onboarded": { "type": "boolean" }
        }
    }
  }
}
